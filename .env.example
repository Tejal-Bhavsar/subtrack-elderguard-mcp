# SubTrack & ElderGuard MCP Server Environment Configuration

# Server Port (default: 3000)
PORT=3000

# AWS Bedrock Configuration (Optional for Cloud AI Analysis)
# If omitted, the server operates seamlessly using the built-in Intelligent Neural Guard Heuristic Engine.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
